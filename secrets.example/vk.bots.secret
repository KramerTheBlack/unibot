# VK Platform Bot Secrets
# Version: 2026.10.21_1

[connection]
access_token = vk_access_token_here_change_me
api_version = 5.131
group_id = vk_group_id_here

[webhook]
secret_key = vk_webhook_secret_key_here
confirmation_code = vk_confirmation_code_here

[settings]
long_poll_enabled = true
webhook_enabled = false
base_url = https://your-domain.com/vk/webhook

[permissions]
can_send_messages = true
can_read_messages = true
can_access_group_info = true
