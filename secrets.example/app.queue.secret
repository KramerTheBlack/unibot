# App Queue Module Secrets
# Version: 2026.10.21_1

[database]
type = sqlite
path = /var/unibot/secrets/app.queue.db

[redis]
host = localhost
port = 6379
password = redis_password_here_change_me
db = 0

[api_keys]
sms_api_key = sms_api_key_here_change_me
email_api_key = email_api_key_here_change_me

[settings]
max_queue_size = 10000
processing_interval = 60
retention_days = 30
