# LLM Module Secrets
# Version: 2026.10.21_1

[openai]
api_key = openai_api_key_here_change_me
api_url = https://api.openai.com/v1
model = gpt-4

[yandex]
api_key = yandex_api_key_here_change_me
api_url = https://api.cloud.yandex.net/foundationModels/v1
folder_id = yandex_folder_id_here
model = yandexgpt-lite

[local]
api_url = http://localhost:11434/v1
model = llama3

[default]
provider = openai
max_tokens = 2000
temperature = 0.7
top_p = 0.9

[moderation]
enabled = true
safe_mode = true
blocked_topics = politics, violence, adult_content

[request_formatting]
system_prompt = You are a helpful assistant for UniBot. Be concise and helpful.
prefix = ""
suffix = ""
