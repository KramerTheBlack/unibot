# MAX Messenger Bot Secrets
# Version: 2026.10.21_1

[connection]
api_key = max_api_key_here_change_me
bot_id = max_bot_id_here

[webhook]
secret_key = max_webhook_secret_key_here

[settings]
webhook_enabled = false
base_url = https://your-domain.com/max/webhook

[permissions]
can_send_messages = true
can_read_messages = true
can_access_user_info = true
