# Telegram Bot Secrets
# Version: 2026.10.21_1

[connection]
bot_token = telegram_bot_token_here_change_me
api_url = https://api.telegram.org/bot

[webhook]
secret_token = telegram_webhook_secret_token_here

[settings]
webhook_enabled = false
base_url = https://your-domain.com/telegram/webhook
polling_timeout = 60
max_connections = 40

[permissions]
can_send_messages = true
can_read_messages = true
can_access_user_info = true
