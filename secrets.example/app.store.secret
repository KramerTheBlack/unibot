# App Store Module Secrets
# Version: 2026.10.21_1

[database]
type = sqlite
path = /var/unibot/secrets/app.store.db

[api_keys]
stripe_key = stripe_api_key_here_change_me
paypal_key = paypal_api_key_here_change_me

[encryption]
secret_key = app_store_encryption_key_here

[settings]
currency = RUB
max_items_per_order = 100
tax_rate = 0.20
