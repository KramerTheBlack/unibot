# App Tracking Module Secrets
# Version: 2026.10.21_1

[database]
type = sqlite
path = /var/unibot/secrets/app.tracking.db

[api_keys]
analytics_key = analytics_api_key_here_change_me
geocoding_key = geocoding_api_key_here_change_me

[encryption]
secret_key = tracking_encryption_key_here

[settings]
retention_days = 365
max_events_per_user = 10000
gps_tracking = false
